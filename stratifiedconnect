library(DBI)
library(odbc)

# Connect directly to your SSMS database instance
con <- dbConnect(odbc::odbc(),
                 Driver   = "SQL Server",
                 Server   = "YOUR_SERVER_NAME",
                 Database = "YOUR_DATABASE_NAME",
                 Trusted_Connection = "True")

# Stream only the 40k location data directly into R for the Jointlcmm model
site_9_data <- dbGetQuery(con, "SELECT * FROM FinalStratifiedSites WHERE assigned_study_site = 'Location_9_40k'")
